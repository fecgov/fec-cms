{% macro citation_list_separator(loop) -%}
  {%- if not loop.first %}{% if loop.last %} and {% else %}, {% endif %}{% endif -%}
{%- endmacro %}

{% macro previous_links(citations) -%}
  {%- for citation in citations -%}
    {{- citation_list_separator(loop) -}}
    {% if citation.ej_unavailable %}§ {{ citation.citation }}{% else %}<a href="{{ citation.url }}"{% if citation.external %} target="_blank" rel="noopener noreferrer"{% endif %}>§ {{ citation.citation }}</a>{% endif %}
  {%- endfor -%}
{%- endmacro %}

{% macro later_links(citations) -%}
  {%- for citation in citations -%}
    {{- citation_list_separator(loop) -}}
    <a href="{{ citation.url }}">§ {{ citation.display_citation }}</a>
  {%- endfor -%}
{%- endmacro %}

{% macro related(section, category, label, spacing='') %}
  <div class="rich-text {{ spacing }}" aria-live="polite"
       data-regulation-related-url="/legal/regulations/{{ section }}/related/{{ category }}/"
       data-regulation-related-label="{{ label }}">
    <a href="/legal/regulations/{{ section }}/related/{{ category }}/">View {{ label }}</a>
  </div>
{% endmacro %}
