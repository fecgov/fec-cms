{% extends "legal-search-results-regulations.jinja" %}
{% import 'macros/regulations.jinja' as regulation_ui %}

{% block title %}
  {% if regulation %}
    {{ regulation.heading_text }}
  {% else %}
    11 CFR {{ section }}{% if reserved_label %} [Reserved]{% endif %}
  {% endif %}
{% endblock %}

{% block message %}
  {% if regulations_api_error %}
    <div class="message message--error" role="alert">
      <p>{{ regulations_api_error }}</p>
    </div>
  {% elif historical_only %}
    <div class="message message--info" role="status">
      {% if reserved_label %}
        <p>This section is reserved in the current eCFR and has no regulatory text. Historical and related legal records are shown in the timeline of changes section.</p>
      {% else %}
        <p>This section does not have current eCFR text. Historical and related legal records are shown in the timeline of changes section.</p>
      {% endif %}
    </div>
  {% endif %}
{% endblock %}

{% block title_action %}
  <a
    class="button--alt button--back legal-regulation__back-link t-sans"
    href="{{ back_url }}"
  >Back to regulation search results</a>
{% endblock %}

{% block results_main_open %}
  <div class="legal-regulation__main-column">
{% endblock %}

{% block results_main_close %}
  </div>
{% endblock %}

{% block results_sidebar %}
  <div class="sidebar-container legal-regulation__sidebar-container">
    <aside class="sidebar sidebar--neutral legal-regulation__sidebar">
      <h2 class="sidebar__title">eCFR timeline of changes</h2>
      <div class="sidebar__content">
        {% if timeline_api_error %}
          <p>{{ timeline_api_error }}</p>
        {% elif timeline %}
          <p class="t-note">eCFR comparison links are available from January 3, 2017 onward. The earliest available eCFR version is December 23, 2016. For earlier Title 11 history, reference FEC Historical E&amp;J records.</p>
          <ul class="list--unstyled">
            {% for item in timeline %}
              <li class="u-margin--bottom">
                <div class="t-bold">{{ item.action }}</div>
                {% if item.issue_date %}
                  <div class="t-note">Issue date: {{ item.issue_date }}</div>
                {% endif %}
                {% if item.amendment_date and item.amendment_date != item.issue_date %}
                  <br />
                  <div class="t-note">Amendment date: {{ item.amendment_date }}</div>
                {% endif %}
                {% if item.compare_url %}
                  <div><a href="{{ item.compare_url }}">Compare with current eCFR</a></div>
                {% elif item.historical_url %}
                  <div><a href="{{ item.historical_url }}">Open historical version</a></div>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <p>No eCFR timeline data available for this section.</p>
        {% endif %}
      </div>
      <h2 class="sidebar__title">FEC historical E&amp;J records and citation changes</h2>
      <div class="sidebar__content">
        {% if historical_regulation_event_groups %}
          <p class="t-note u-padding--bottom">E&amp;J documents and citation changes come from separate FEC indexes. Some E&amp;Js discuss a provision under a broader parent citation.</p>
          <ul class="list--unstyled legal-regulation__history-list">
            {% for group in historical_regulation_event_groups %}
              {% set group_display_citation = group.section ~ (group.subsection|replace('-', '–')) %}
              <li class="legal-regulation__history-record" id="{{ group.anchor_id }}">
                <div class="legal-regulation__history-citation">
                  {{ group.section }}{% if group.subsection %}{{ group.subsection }}{% endif %}
                </div>
                <div class="legal-regulation__history-details">
                  {% if group.citation_note %}
                    <div class="legal-regulation__citation-history-box">
                      <h3 class="legal-regulation__citation-history-title">Citation note for § {{ group_display_citation }}</h3>
                      {% include 'partials/legal-regulation-group-citation-note.jinja' %}
                    </div>
                  {% endif %}
                  {% for event in group.citation_events %}
                    {% with citation_context_label = 'Citation note for § ' ~ group_display_citation %}
                      {% include 'partials/legal-regulation-event-citation-change.jinja' %}
                    {% endwith %}
                  {% endfor %}
                  {% if group.subject_groups %}
                    <ul class="list--unstyled legal-regulation__history-subject-list">
                      {% for subject_group in group.subject_groups %}
                        <li class="legal-regulation__history-event legal-regulation__history-subject-group">
                          <h3 class="legal-regulation__history-subject">{{ subject_group.label }}</h3>
                          <div class="legal-regulation__history-documents">
                            {% if subject_group.events|length == 1 %}
                              {% set event = subject_group.events[0] %}
                              <div class="legal-regulation__history-document legal-regulation__history-document--single">
                                <span class="legal-regulation__history-documents-label">E&amp;J document:</span>
                                {% if event.source_url %}<a href="{{ event.source_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ subject_group.label }}, {{ event.document_label }}">{% endif %}
                                <span class="legal-regulation__history-date">{{ event.document_label }}</span>
                                {% if event.source_url %}</a>{% endif %}
                              </div>
                            {% else %}
                              <span class="legal-regulation__history-documents-label">E&amp;J documents:</span>
                              <ul class="list--unstyled legal-regulation__history-document-list" aria-label="E&amp;J documents for {{ subject_group.label }}">
                              {% for event in subject_group.events %}
                                <li class="legal-regulation__history-document">
                                  {% if event.source_url %}<a href="{{ event.source_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ subject_group.label }}, {{ event.document_label }}">{% endif %}
                                  <span class="legal-regulation__history-date">{{ event.document_label }}</span>
                                  {% if event.source_url %}</a>{% endif %}
                                </li>
                              {% endfor %}
                              </ul>
                            {% endif %}
                          </div>
                        </li>
                      {% endfor %}
                    </ul>
                  {% elif group.events %}
                    <ul class="list--unstyled">
                      {% for event in group.events %}
                        <li class="legal-regulation__history-event">
                          {% if event.label %}
                            {% if event.source_url %}<a href="{{ event.source_url }}" target="_blank" rel="noopener noreferrer">{% endif %}
                            <span class="legal-regulation__history-subject">{{ event.label }}</span>{% if event.date %} <span class="legal-regulation__history-date">({{ event.date }})</span>{% endif %}
                            {% if event.source_url %}</a>{% endif %}
                          {% elif event.date %}
                            <span class="legal-regulation__history-date">({{ event.date }})</span>
                          {% endif %}
                        </li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </div>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <p>No FEC historical E&amp;J records available for this section.</p>
        {% endif %}
      </div>
    </aside>
  </div>
{% endblock %}

{% block results %}
<div class="legal-regulation">
  <div class="row legal-regulation__layout">
    <div class="main__content">
      <header class="legal-regulation__section-heading">
        {% if section_nav.part %}
          <h2 class="legal-regulation__part t-bold">Part {{ section_nav.part.no }} &mdash; {{ section_nav.part.description }}</h2>
        {% endif %}
        {% if not regulation and reserved_label %}
          <h3>{{ reserved_label }}</h3>
        {% endif %}
      </header>
      {% if regulation or reserved_label %}
        <section class="content__section">
          {% if regulation %}
            <div class="rich-text">
              <h3>{{ regulation.heading|safe }}</h3>
              {% for block in regulation.body %}
                {{ block|safe }}
              {% endfor %}
            </div>
          {% endif %}
          {% if section_nav.previous or section_nav.next %}
            <div class="grid grid--2-wide u-border-top-base u-padding--top u-margin--top">
              <div class="grid__item">
                {% if section_nav.previous %}
                  <a class="button--alt button--back legal-regulation__previous-section-link" href="{{ section_nav.previous.url }}">
                    <div>Previous section - § {{ section_nav.previous.no }}</div>
                  </a>
                  <h3 class="t-sans">{{ section_nav.previous.description }}</h3>
                {% endif %}
              </div>
              <div class="grid__item t-right-aligned">
                {% if section_nav.next %}
                  <a class="button--alt button--go legal-regulation__next-section-link" href="{{ section_nav.next.url }}">
                    <div>Next section - § {{ section_nav.next.no }}</div>
                  </a>
                  <h3 class="t-sans">{{ section_nav.next.description }}</h3>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </section>
      {% endif %}

      <section id="legal-citations" class="content__section">
        <div class="sidebar--neutral t-sans">
          <h4 class="sidebar__title">Legal citations</h4>
          <div class="sidebar__content">
            <div class="grid grid--2-wide">
              {# Statutes #}
              <div class="grid__item">
                <div class="t-bold">Statutes</div>
                <div class="rich-text u-margin--bottom--large">
                  {% if regulation.statutory_citations %}
                    <ul class="list--unstyled">
                      {% for citation in regulation.statutory_citations %}
                        <li class="u-margin--bottom">{% if citation.url %}<a href="{{ citation.url }}">{{ citation.label }}</a>{% else %}{{ citation.label }}{% endif %}</li>
                      {% endfor %}
                    </ul>
                  {% else %}
                    <div>No statutory citations found for this regulatory citation.</div>
                  {% endif %}
                </div>
                <div class="t-bold">Rulemakings</div>
                {{ regulation_ui.related(section, 'rulemakings', 'rulemakings', '') }}
              </div>
              {# AOs and MURs #}
              <div class="grid__item">
                <div class="t-bold">AOs citing this regulation</div>
                {{ regulation_ui.related(section, 'advisory-opinions', 'advisory opinions', 'u-margin--bottom--large') }}
                <div class="t-bold">MURs citing this regulation</div>
                {{ regulation_ui.related(section, 'murs', 'MURs', '') }}
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
{% endblock %}
